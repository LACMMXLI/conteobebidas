// ============================================================================
// Conteo de Bebidas — Modelo de datos
// ============================================================================
// Diseñado para: captura rápida diaria + historial auditable.
// Preparado (solo a nivel de relaciones/IDs) para incorporar a futuro:
// ventas, consumo teórico, existencia esperada/física, diferencias, mermas,
// transferencias, alertas y reportes — sin implementar esas funciones aún.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Usuarios y roles
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  ENCARGADO
  CAPTURISTA
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)

  // Permiso fino: un ENCARGADO puede o no tener permiso de corregir conteos
  // cerrados. ADMIN siempre puede (se valida en código, no depende de este flag).
  canCorrectClosedCounts Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchAccess      UserBranch[]
  countsCreated     Count[]        @relation("CountCreatedBy")
  countsFinalized   Count[]        @relation("CountFinalizedBy")
  countItemEdits    CountItem[]    @relation("CountItemLastEditedBy")
  auditEntries      CountAudit[]   @relation("AuditModifiedBy")
  refreshTokens     RefreshToken[]

  @@map("users")
}

// Acceso de un usuario a una o varias sucursales (necesario para ENCARGADO/CAPTURISTA
// multi-sucursal; un ADMIN puede o no tener filas aquí, su acceso es global).
model UserBranch {
  id       String @id @default(uuid())
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@map("user_branches")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// Sucursales
// ----------------------------------------------------------------------------

model Branch {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  // Hora de cierre operativo (formato "HH:mm", zona horaria de la sucursal).
  // Ej: "04:00" significa que el "día operativo" corre de 04:00 a 04:00 del
  // día siguiente. Necesario porque algunas sucursales trabajan tras medianoche.
  operationalCloseHour String @default("00:00")
  timezone             String @default("America/Mexico_City")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess      UserBranch[]
  productAccess   ProductBranch[]
  counts          Count[]

  @@map("branches")
}

// ----------------------------------------------------------------------------
// Catálogo de productos
// ----------------------------------------------------------------------------

// Área de almacenamiento física — determina en qué sección de la pantalla
// de captura aparece el producto.
enum StorageArea {
  REFRIGERADOR
  ALMACEN
}

model Product {
  id           String      @id @default(uuid())
  name         String
  category     String
  presentation String?
  storageArea  StorageArea
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchAssignments ProductBranch[]
  countItems        CountItem[]

  @@map("products")
}

// Asignación de un producto a una sucursal (un producto puede venderse/contarse
// solo en algunas sucursales).
model ProductBranch {
  id        String  @id @default(uuid())
  productId String
  branchId  String
  isActive  Boolean @default(true)

  // Permite reordenar productos por sucursal sin afectar el orden global.
  displayOrder Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@map("product_branches")
}

// ----------------------------------------------------------------------------
// Conteos
// ----------------------------------------------------------------------------

enum CountStatus {
  OPEN
  FINALIZED
}

// Un "Count" = el conteo de UNA sucursal para UNA fecha operativa.
// Contiene un CountItem por producto asignado a esa sucursal.
model Count {
  id              String      @id @default(uuid())
  branchId        String
  operationalDate DateTime    @db.Date
  status          CountStatus @default(OPEN)

  createdById   String
  createdAt     DateTime  @default(now())
  finalizedById String?
  finalizedAt   DateTime?

  updatedAt DateTime @updatedAt

  branch      Branch      @relation(fields: [branchId], references: [id])
  createdBy   User        @relation("CountCreatedBy", fields: [createdById], references: [id])
  finalizedBy User?       @relation("CountFinalizedBy", fields: [finalizedById], references: [id])
  items       CountItem[]

  // No se puede duplicar un conteo para la misma sucursal + fecha operativa.
  @@unique([branchId, operationalDate])
  @@index([branchId, status])
  @@map("counts")
}

model CountItem {
  id        String @id @default(uuid())
  countId   String
  productId String

  // Cantidades capturadas. Nullable = aún no capturado (para poder detectar
  // "faltantes" antes de finalizar).
  opening Decimal? @db.Decimal(12, 2)
  entries Decimal? @db.Decimal(12, 2)
  closing Decimal? @db.Decimal(12, 2)

  lastEditedById String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  count        Count        @relation(fields: [countId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  lastEditedBy User?        @relation("CountItemLastEditedBy", fields: [lastEditedById], references: [id])
  auditEntries CountAudit[]

  @@unique([countId, productId])
  @@map("count_items")
}

// ----------------------------------------------------------------------------
// Auditoría
// ----------------------------------------------------------------------------

enum CountField {
  OPENING
  ENTRIES
  CLOSING
}

// Registro inmutable de cada corrección hecha a un conteo YA finalizado.
// El valor nunca se sobrescribe silenciosamente: siempre queda constancia
// del valor anterior, el nuevo, quién y por qué.
model CountAudit {
  id          String     @id @default(uuid())
  countItemId String
  field       CountField

  previousValue Decimal? @db.Decimal(12, 2)
  newValue      Decimal? @db.Decimal(12, 2)

  reason         String
  modifiedById   String
  modifiedAt     DateTime @default(now())

  countItem  CountItem @relation(fields: [countItemId], references: [id], onDelete: Cascade)
  modifiedBy User      @relation("AuditModifiedBy", fields: [modifiedById], references: [id])

  @@index([countItemId])
  @@map("count_audits")
}
